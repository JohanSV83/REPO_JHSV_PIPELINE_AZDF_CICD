{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfjhsvprod01"
		},
		"lnk_Onpremise_Comercial_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'lnk_Onpremise_Comercial'"
		},
		"lnk_Onpremise_dwComercial_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'lnk_Onpremise_dwComercial'"
		},
		"lnk_stgen2_raw_data_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'lnk_stgen2_raw_data'"
		},
		"LNK_HTTP_API_REST_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/anshlambagit"
		},
		"lnk_Onpremise_Comercial_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-RQJV90QN"
		},
		"lnk_Onpremise_Comercial_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_comercial"
		},
		"lnk_Onpremise_Comercial_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "JOHAN_BIGDATA"
		},
		"lnk_Onpremise_dwComercial_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-RQJV90QN"
		},
		"lnk_Onpremise_dwComercial_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DW_COMERCIAL"
		},
		"lnk_Onpremise_dwComercial_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "JOHAN_BIGDATA"
		},
		"lnk_stgen2_raw_data_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stgjhsvprod01.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfjhsvprod01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"lnk_stgen2_raw_data_accountKey": {
						"value": "[parameters('lnk_stgen2_raw_data_accountKey')]"
					},
					"LNK_HTTP_API_REST_properties_typeProperties_url": {
						"value": "[parameters('LNK_HTTP_API_REST_properties_typeProperties_url')]"
					},
					"lnk_stgen2_raw_data_properties_typeProperties_url": {
						"value": "[parameters('lnk_stgen2_raw_data_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfjhsvprod01_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"lnk_Onpremise_Comercial_password": {
						"value": "[parameters('lnk_Onpremise_Comercial_password')]"
					},
					"lnk_Onpremise_dwComercial_password": {
						"value": "[parameters('lnk_Onpremise_dwComercial_password')]"
					},
					"lnk_Onpremise_Comercial_properties_typeProperties_server": {
						"value": "[parameters('lnk_Onpremise_Comercial_properties_typeProperties_server')]"
					},
					"lnk_Onpremise_Comercial_properties_typeProperties_database": {
						"value": "[parameters('lnk_Onpremise_Comercial_properties_typeProperties_database')]"
					},
					"lnk_Onpremise_Comercial_properties_typeProperties_userName": {
						"value": "[parameters('lnk_Onpremise_Comercial_properties_typeProperties_userName')]"
					},
					"lnk_Onpremise_dwComercial_properties_typeProperties_server": {
						"value": "[parameters('lnk_Onpremise_dwComercial_properties_typeProperties_server')]"
					},
					"lnk_Onpremise_dwComercial_properties_typeProperties_database": {
						"value": "[parameters('lnk_Onpremise_dwComercial_properties_typeProperties_database')]"
					},
					"lnk_Onpremise_dwComercial_properties_typeProperties_userName": {
						"value": "[parameters('lnk_Onpremise_dwComercial_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfjhsvprod01_ArmTemplate_0')]"
			]
		},
		{
			"name": "adfjhsvprod01_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfjhsvprod01_ArmTemplate_1')]"
			]
		}
	]
}