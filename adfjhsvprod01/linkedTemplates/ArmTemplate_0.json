						"userProperties": [],
						"typeProperties": {
							"variableName": "var_lenght_array",
							"value": {
								"value": "@string(length(pipeline().parameters.P_input_array))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Set variableRangeOfIndex",
						"type": "SetVariable",
						"dependsOn": [
							{
