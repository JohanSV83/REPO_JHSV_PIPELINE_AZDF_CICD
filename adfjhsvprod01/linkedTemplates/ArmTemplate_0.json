		{
			"name": "[concat(parameters('factoryName'), '/PL_HANDLE_TO_ARRAYS_REVERSE')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Set variableLength",
						"type": "SetVariable",
						"dependsOn": [],
