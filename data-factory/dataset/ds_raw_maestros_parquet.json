{
	"name": "ds_raw_maestros_parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "lnk_stgen2_raw_data",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"servername": {
				"type": "string"
			},
			"databasename": {
				"type": "string"
			},
			"schemaname": {
				"type": "string"
			},
			"tablename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().schemaname,'_',dataset().tablename,'.parquet')",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(dataset().servername,'/',dataset().databasename,'/',dataset().schemaname,'/',dataset().tablename,'/anio=',formatDateTime(utcnow(),'yyyy'),'/mes=',formatDateTime(utcnow(),'MM'),'/dia=',formatDateTime(utcnow(),'dd'))",
					"type": "Expression"
				},
				"fileSystem": "raw"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}